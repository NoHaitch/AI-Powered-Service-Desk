# Loopback HTTPS entry point. No data service ports are published.
DESK_HTTPS_PORT=8443
# Release-style Compose defaults to false and the development override defaults to true.
# DESK_SWAGGER_ENABLED=false
# Set explicitly when using a different trusted loopback hostname or port.
# DESK_AUTH_ORIGIN=https://localhost:8443
# Keep the reserved frontend address inside the dedicated edge subnet.
# DESK_AUTH_PROXY_SUBNET=172.28.249.0/24
# DESK_AUTH_PROXY_PEER=172.28.249.2
# Authentication keys are generated by scripts/setup_local.py and mounted from .local/.
# DESK_LOCAL_SECRET_DIR=./.local
